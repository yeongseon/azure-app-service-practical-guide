{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeongseon.github.io/azure-app-service-practical-guide/schemas/golden/run-declarations.schema.json",
  "title": "Golden retained run declarations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "runs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario",
          "retained_package"
        ],
        "properties": {
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "retained_package": {
            "type": "string",
            "pattern": "^evidence/runs/[A-Za-z0-9._-]+$"
          }
        }
      }
    }
  }
}
