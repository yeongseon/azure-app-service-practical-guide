      {"id": "identity", "component": "identity", "label": "Identity: Microsoft Entra ID<br/>[Tenant Boundary]", "class": "bandMuted"},
      {"id": "storage_db", "component": "storage-db", "label": "Dependency: Azure Storage<br/>[Data Store]", "class": "baseNeutral"},
      {"id": "telemetry", "component": "telemetry", "label": "Telemetry: Azure Monitor<br/>[Off-Path Sink]", "class": "bandMuted"}
    ],
    "edges": [
      {"id": "arm", "from": "control_plane", "to": "ingress", "style": "dotted", "label": "[Configured] ARM policy"},
      {"id": "scm", "from": "control_plane", "to": "app_runtime", "style": "dotted", "label": "[Configured] SCM deploy"},
      {"id": "request", "from": "client", "to": "ingress", "style": "solid", "label": "[Configured] HTTPS 443 request"},
      {"id": "route", "from": "ingress", "to": "app_runtime", "style": "solid", "label": "[Configured] Routed request"},
      {"id": "token", "from": "app_runtime", "to": "identity", "style": "dotted", "label": "[Configured] Managed identity token"},
      {"id": "storage", "from": "app_runtime", "to": "storage_db", "style": "solid", "label": "[Configured] HTTPS 443 shared outbound IP"},
      {"id": "logs", "from": "app_runtime", "to": "telemetry", "style": "dotted", "label": "[Configured] Logs and metrics"}
    ]
  },
  "extensions": {
    "ingress-pe": {
      "nodes": [
        {"id": "dns", "component": "dns", "label": "Private DNS zone: privatelink.azurewebsites.net<br/>[linked to the VNet]", "class": "bandMuted"},
        {"id": "private_endpoint", "component": "private-endpoint", "label": "Private Endpoint: App Service Inbound NIC<br/>[Inbound Private IP]", "class": "focusActive"}
      ],
      "containers": [
        {"id": "vnet_in", "component": "vnet", "title": "Customer VNet", "tag": "[VNet boundary]", "members": ["subnet_pe"]},
