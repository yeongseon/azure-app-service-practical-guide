        {"id": "pe_in", "from": "client", "to": "private_endpoint", "style": "solid", "label": "[Configured] 2. HTTPS 443 to PE private IP"},
        {"id": "private_in", "from": "private_endpoint", "to": "ingress", "style": "solid", "label": "[Configured] 3. Private Link inbound"}
      ]}
    },
    "egress-vnet": {
      "nodes": [
        {"id": "dns_out", "component": "dns", "label": "Private DNS zone: privatelink.blob.core.windows.net<br/>[linked to the VNet]", "class": "bandMuted"},
        {"id": "vnet_integration", "component": "vnet-integration", "label": "VNet Integration: Delegated Outbound Subnet NIC<br/>[Delegated Subnet / Outbound Only]", "class": "focusActive"},
        {"id": "pe_storage", "component": "private-endpoint", "label": "Private Endpoint: Azure Storage Inbound NIC<br/>[Private Endpoint Subnet IP]", "class": "focusActive"}
      ],
      "containers": [
        {"id": "vnet_out", "component": "vnet", "title": "Customer VNet", "tag": "[VNet boundary]", "members": ["subnet_int", "subnet_pe_out"]},
        {"id": "subnet_int", "component": "subnet", "title": "Subnet: VNet integration", "tag": "[delegated, NSG/UDR]", "members": ["vnet_integration"]},
        {"id": "subnet_pe_out", "component": "subnet", "title": "Subnet: private endpoints", "tag": "[private endpoint NICs]", "members": ["pe_storage"]}
      ],
      "replace_edges": {"storage": [
        {"id": "dns_lookup", "from": "app_runtime", "to": "dns_out", "style": "dotted", "label": "[Configured] 1. DNS lookup returns PE private IP"},
        {"id": "outbound", "from": "app_runtime", "to": "vnet_integration", "style": "solid", "label": "[Configured] 2. Outbound VNet traffic"},
        {"id": "pe_out", "from": "vnet_integration", "to": "pe_storage", "style": "solid", "label": "[Configured] 3. HTTPS 443 to PE private IP"},
        {"id": "private_out", "from": "pe_storage", "to": "storage_db", "style": "solid", "label": "[Configured] 4. Private Link to Storage"}
      ]}
    }
  },
  "overlays": {
    "egress-failure": {
      "type": "failure",
      "nodes": {
        "dns_out": {"label": "Private DNS zone: privatelink.blob.core.windows.net<br/>[unlinked to VNet]", "class": "stateFault"},
        "pe_storage": {"label": "Private Endpoint: Azure Storage Inbound NIC<br/>[Unused Private Path]", "class": "focusActive"}
      },
      "replace_edges": {
        "dns_lookup": [{"id": "dns_lookup", "from": "app_runtime", "to": "dns_out", "style": "fault", "label": "[FAULT / Illustrative] 1. Lookup returns public IP"}],
        "pe_out": [{"id": "pe_out", "from": "vnet_integration", "to": "pe_storage", "style": "dotted", "label": "[Configured] unused"}],
        "private_out": [
          {"id": "private_out", "from": "pe_storage", "to": "storage_db", "style": "dotted", "label": "[Configured] unused"},
          {"id": "rejection", "from": "vnet_integration", "to": "storage_db", "style": "fault", "label": "[FAULT / Illustrative] 3."}
        ]
      },
      "callout": {"id": "fault_note", "anchor": "dns_out", "edge_label": "[FAULT / Illustrative] Callout", "lines": ["[Illustrative scenario - not a measurement]", "Symptom: storage calls fail with HTTP 403", "Evidence to collect: IP address the app resolves for the storage host name", "Next check: Private DNS zone virtual network link"]}
    }
  },
